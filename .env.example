PORT=3000

# Supabase project htv2. Never commit the real secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Generate long independent values for production.
JWT_SECRET=replace-with-at-least-32-random-characters
LICENSE_PRIVATE_KEY=replace-with-ed25519-pkcs8-base64url

# Must also be present in Supabase Authentication > URL Configuration > Redirect URLs.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password

# Optional extra browser origins, comma-separated. Tauri and local Vite origins are built in.
CORS_ORIGINS=
